# Base URL of aretos-be. `localhost` only resolves on a simulator; on a
# physical device use the LAN IP the Metro bundler prints.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Must match `scheme` in app.json AND be listed verbatim in the backend's
# AUTH_ALLOWED_REDIRECT_URIS (exact string match, see aretos-be/docs/auth.md).
EXPO_PUBLIC_AUTH_REDIRECT_URI=aretos://auth/callback
